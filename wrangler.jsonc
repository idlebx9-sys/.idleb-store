{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idleb-store",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "STORE_DATA"
    }
  ]
}
